{
  "name": "ai-orchestration-console",
  "version": "0.1.0",
  "private": true,
  "bin": { "orch": "./bin/orch.js" },
  "packageManager": "npm@10.9.8",
  "engines": {
    "node": ">=22 <23",
    "npm": ">=10.9.0 <11"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "typecheck": "tsc --noEmit",
    "test": "node --experimental-strip-types --disable-warning=ExperimentalWarning --disable-warning=MODULE_TYPELESS_PACKAGE_JSON --test src/",
    "build:cli": "esbuild src/cli/index.ts --bundle --platform=node --format=cjs --target=node22 --outfile=bin/orch.js --banner:js='#!/usr/bin/env -S node --no-warnings'",
    "prepare": "husky"
  },
  "dependencies": {
    "next": "15.5.22",
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "devDependencies": {
    "@secretlint/secretlint-rule-preset-recommend": "^13.0.4",
    "@types/node": "^22.10.5",
    "@types/react": "^19.0.7",
    "@types/react-dom": "^19.0.3",
    "esbuild": "^0.28.2",
    "husky": "^9.1.7",
    "lint-staged": "^17.3.0",
    "secretlint": "^13.0.4",
    "typescript": "^5.7.3"
  },
  "overrides": {
    "sharp": "^0.35.0",
    "postcss": "^8.5.25",
    "nanoid": "^3.3.17"
  },
  "lint-staged": {
    "*": "secretlint"
  }
}
